{
  "name": "webboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "version:check": "node scripts/version.mjs --check",
    "test:scripts": "node --test scripts/*.test.mjs && bash scripts/install-linux.test.sh",
    "layout:probe": "node scripts/layout-probe.mjs",
    "gantt:wbx": "vite-node scripts/gantt-to-wbx.mjs --",
    "lint": "eslint --max-warnings 0 src"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "fractional-indexing": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "y-partyserver": "2.2.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.12.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
